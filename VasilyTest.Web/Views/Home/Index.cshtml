@model IEnumerable<VasilyTest.Web.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Products</h1>
    <button type="button" class="btn btn-success" onclick="openAdd()">Add +</button>
</div>


<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th style="width:80px">Id</th>
            <th>Name</th>
            <th style="width:120px">Price</th>
            <th style="width:170px">Created</th>
            <th style="width:190px"></th>
        </tr>
    </thead>
    <tbody id="productsBody">
        @foreach (var p in Model)
        {
            <tr id="row-@p.Id">
                <td>@p.Id</td>
                <td class="cell-name">@p.Name</td>
                <td class="cell-price">@p.Price.ToString("0.00")</td>
                <td class="cell-created">@p.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <button type="button" class="btn btn-sm btn-primary" onclick="openUpdate(@p.Id)">Update</button>
                    <button type="button" class="btn btn-sm btn-danger" onclick="openDelete(@p.Id)">Delete</button>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr id="emptyRow"><td colspan="5" class="text-center text-muted">No products yet</td></tr>
        }
    </tbody>
</table>

<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productModalTitle">Update Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="formId" />
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" id="formName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Price</label>
                    <input type="number" step="0.01" class="form-control" id="formPrice" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveBtn" onclick="save()">Update</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let productModal, deleteModal, deleteId = null;

    document.addEventListener('DOMContentLoaded', function () {
        productModal = new bootstrap.Modal(document.getElementById('productModal'));
        deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
    });

    function openAdd() {
        document.getElementById('productModalTitle').textContent = 'Add Product';
        document.getElementById('saveBtn').textContent = 'Add';
        document.getElementById('formId').value = '0';
        document.getElementById('formName').value = '';
        document.getElementById('formPrice').value = '';
        productModal.show();
    }

    function openUpdate(id) {
        const row = document.getElementById('row-' + id);
        document.getElementById('productModalTitle').textContent = 'Update Product';
        document.getElementById('saveBtn').textContent = 'Update';
        document.getElementById('formId').value = id;
        document.getElementById('formName').value = row.querySelector('.cell-name').textContent.trim();
        document.getElementById('formPrice').value = row.querySelector('.cell-price').textContent.trim();
        productModal.show();
    }

    async function save() {
        const fd = new FormData();
        fd.append('id', document.getElementById('formId').value);
        fd.append('name', document.getElementById('formName').value);
        fd.append('price', document.getElementById('formPrice').value || '0');

        const res = await fetch('/Home/Save', { method: 'POST', body: fd });
        if (!res.ok) { alert('Error: ' + res.status); return; }
        const p = await res.json();

        let row = document.getElementById('row-' + p.id);
        if (!row) {
            const empty = document.getElementById('emptyRow');
            if (empty) empty.remove();
            row = document.createElement('tr');
            row.id = 'row-' + p.id;
            row.innerHTML =
                '<td>' + p.id + '</td>' +
                '<td class="cell-name"></td>' +
                '<td class="cell-price"></td>' +
                '<td class="cell-created"></td>' +
                '<td>' +
                '<button type="button" class="btn btn-sm btn-primary" onclick="openUpdate(' + p.id + ')">Update</button> ' +
                '<button type="button" class="btn btn-sm btn-danger" onclick="openDelete(' + p.id + ')">Delete</button>' +
                '</td>';
            document.getElementById('productsBody').appendChild(row);
        }

        row.querySelector('.cell-name').textContent = p.name;
        row.querySelector('.cell-price').textContent = p.price;
        row.querySelector('.cell-created').textContent = p.createdAt;

        alert('Updated');
        productModal.hide();
    }

    function openDelete(id) {
        deleteId = id;
        deleteModal.show();
    }

    async function confirmDelete() {
        const fd = new FormData();
        fd.append('id', deleteId);

        const res = await fetch('/Home/Delete', { method: 'POST', body: fd });
        if (!res.ok) { alert('Error: ' + res.status); return; }

        document.getElementById('row-' + deleteId).remove();
        deleteModal.hide();
    }
</script>
}